{
  "$defs": {
    "AgentErrorCode": {
      "enum": [
        "MISSING_DATA",
        "STALE_INPUT",
        "PROVIDER_UNAVAILABLE",
        "BUDGET_EXCEEDED",
        "INVALID_AGENT_OUTPUT",
        "POLICY_DENIED",
        "DEADLINE_EXCEEDED"
      ],
      "title": "AgentErrorCode",
      "type": "string"
    },
    "DataQuality": {
      "additionalProperties": false,
      "properties": {
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "missing": {
          "items": {
            "type": "string"
          },
          "title": "Missing",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "complete",
        "missing",
        "notes"
      ],
      "title": "DataQuality",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk Id"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "document_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        },
        "document_version_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Version Id"
        },
        "evidence_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "record",
            "document",
            "calculation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "page_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Number"
        },
        "record_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Id"
        },
        "record_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Type"
        },
        "record_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Version"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "description"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "ExecutionMetadata": {
      "additionalProperties": false,
      "properties": {
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "degraded": {
          "title": "Degraded",
          "type": "boolean"
        },
        "degraded_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Degraded Reason"
        },
        "input_tokens": {
          "title": "Input Tokens",
          "type": "integer"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "model_calls": {
          "title": "Model Calls",
          "type": "integer"
        },
        "output_tokens": {
          "title": "Output Tokens",
          "type": "integer"
        },
        "prompt_version": {
          "title": "Prompt Version",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "tool_calls": {
          "items": {
            "type": "string"
          },
          "title": "Tool Calls",
          "type": "array"
        }
      },
      "required": [
        "provider",
        "model",
        "model_calls",
        "tool_calls",
        "input_tokens",
        "output_tokens",
        "prompt_version",
        "degraded",
        "degraded_reason",
        "started_at",
        "completed_at"
      ],
      "title": "ExecutionMetadata",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source": {
          "enum": [
            "deterministic",
            "model"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "severity",
        "code",
        "message",
        "evidence_ids",
        "source"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "name",
        "value",
        "unit"
      ],
      "title": "Metric",
      "type": "object"
    },
    "RecommendedAction": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "title": "Action Id",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "kind": {
          "enum": [
            "ALLOCATION",
            "RESERVATION",
            "ALLOCATION_AND_RESERVATION",
            "REPLENISHMENT_SUGGESTION",
            "QUALITY_HOLD_REVIEW",
            "IE_REVIEW"
          ],
          "title": "Kind",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "rank": {
          "title": "Rank",
          "type": "integer"
        },
        "source": {
          "enum": [
            "deterministic",
            "model"
          ],
          "title": "Source",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "kind",
        "summary",
        "payload",
        "evidence_ids",
        "rank",
        "source"
      ],
      "title": "RecommendedAction",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent": {
      "enum": [
        "planning",
        "rm",
        "ie",
        "quality"
      ],
      "title": "Agent",
      "type": "string"
    },
    "data_quality": {
      "$ref": "#/$defs/DataQuality"
    },
    "error_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentErrorCode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "execution_metadata": {
      "$ref": "#/$defs/ExecutionMetadata"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "input_versions": {
      "additionalProperties": true,
      "title": "Input Versions",
      "type": "object"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/Metric"
      },
      "title": "Metrics",
      "type": "array"
    },
    "recommended_actions": {
      "items": {
        "$ref": "#/$defs/RecommendedAction"
      },
      "title": "Recommended Actions",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "SUCCEEDED",
        "DEGRADED",
        "FAILED"
      ],
      "title": "Status",
      "type": "string"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "summary_source": {
      "enum": [
        "deterministic",
        "model"
      ],
      "title": "Summary Source",
      "type": "string"
    },
    "task_id": {
      "format": "uuid",
      "title": "Task Id",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "agent",
    "status",
    "summary",
    "summary_source",
    "findings",
    "metrics",
    "recommended_actions",
    "evidence_refs",
    "warnings",
    "input_versions",
    "data_quality",
    "execution_metadata"
  ],
  "title": "AgentResult",
  "type": "object"
}
