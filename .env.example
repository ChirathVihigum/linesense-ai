# LineSense AI backend configuration.
#
# Copy to `.env` at the repo root (`cp .env.example .env`) for local
# development. `.env` is git-ignored: never commit real secrets.
#
# All variables use the LS_ prefix and are read by app.settings.Settings
# (pydantic-settings). See docs/architecture/backend-contracts.md section 1.

# One of: development | test | production.
LS_ENVIRONMENT=development

# Runtime (app-role) and migration (owner-role) database URLs. The app role
# has DML-only privileges; the owner role runs migrations and owns the schema.
LS_DATABASE_URL=postgresql+psycopg://linesense_app:dev-app-only@127.0.0.1:55432/linesense_dev
LS_MIGRATION_DATABASE_URL=postgresql+psycopg://linesense_owner:dev-owner-only@127.0.0.1:55432/linesense_dev

# Same, but pointing at the project-local test database (linesense_test).
# Used by the test suite (tests/conftest.py) and `make migration-check`.
LS_TEST_DATABASE_URL=postgresql+psycopg://linesense_app:dev-app-only@127.0.0.1:55432/linesense_test
LS_TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://linesense_owner:dev-owner-only@127.0.0.1:55432/linesense_test

# Runtime database role name (created by scripts/dev-db.sh).
LS_APP_DB_ROLE=linesense_app

# Session cookie signing secret and internal service-to-service bearer
# token. In production these must be >= 32 chars and must not contain
# "dev-" (enforced by Settings' production validator).
LS_SESSION_SECRET=dev-session-secret-change-me-0123456789abcdef
LS_SERVICE_TOKEN=dev-service-token-change-me-0123456789

# Public browser origin (CORS/CSRF/cookie checks) and the API's own
# internal base URL (used for server-to-server calls, e.g. OIDC redirects).
LS_PUBLIC_ORIGIN=http://localhost:5173
LS_API_INTERNAL_URL=http://127.0.0.1:8000

# OIDC identity provider (a local dev IdP in development/test).
LS_OIDC_ISSUER=http://127.0.0.1:8090
LS_OIDC_CLIENT_ID=linesense-web
LS_OIDC_CLIENT_SECRET=dev-oidc-client-secret
LS_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback

# LLM provider: anthropic | fixture | disabled. "fixture" is a deterministic
# test double (never a live model) and is forbidden in production.
LS_LLM_PROVIDER=fixture
LS_ANTHROPIC_API_KEY=
LS_ANTHROPIC_MODEL=claude-opus-5

# Where uploaded/processed documents are stored on disk (dev/test only;
# relative to services/backend).
LS_DOCUMENT_STORAGE_DIR=../../.local/documents

# Embedding model and backend used for retrieval (pgvector).
LS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LS_EMBEDDER=fastembed

# Password for the seeded dev/test OIDC identities (see backend-contracts.md
# section 9). Development/test only.
LS_DEV_IDP_PASSWORD=demo-password
