# LineSense AI — Docker Compose environment (infra/compose/docker-compose.yml).
#
# Copy to infra/compose/.env.compose (git-ignored) before running Compose:
#   cp infra/compose/.env.compose.example infra/compose/.env.compose
#
# Every value below is a placeholder for the local single-host HTTPS demo
# (`docker compose --profile dev up`), matching the style of the repo's own
# .env.example. Never commit real values. See docs/operations/deployment.md
# for what a real production deployment must change: strong, unique secrets
# (LS_SESSION_SECRET / LS_SERVICE_TOKEN must be >= 32 chars and must not
# contain "dev-" once LS_ENVIRONMENT=production — enforced by
# app.settings.Settings), a separately managed and hardened identity
# provider (not the bundled `dev`-profile Keycloak), a real Anthropic API
# key if LS_LLM_PROVIDER=anthropic, and a real TLS certificate in place of
# Caddy's `tls internal`.
#
# Docker was not available in the development environment that produced
# this file: it has been validated statically (`make infra-check`) and has
# never actually been run.

# ---------------------------------------------------------------------------
# Postgres (service `db`) — bootstrap superuser plus the linesense_owner /
# linesense_app roles created by db-init/01-roles.sh (mirrors
# scripts/dev-db.sh). Keep each password in sync with the matching
# LS_*_DATABASE_URL below.
# ---------------------------------------------------------------------------
LS_DB_SUPERUSER=linesense_super
LS_DB_SUPERUSER_PASSWORD=dev-super-only
LS_DB_OWNER_PASSWORD=dev-owner-only
LS_DB_APP_PASSWORD=dev-app-only
LINESENSE_DB_NAME=linesense

# ---------------------------------------------------------------------------
# Backend (services `api`, `worker`, `migrate`) — see
# services/backend/app/settings.py and the repo root .env.example for what
# each LS_* variable does.
# ---------------------------------------------------------------------------
LS_ENVIRONMENT=development

LS_DATABASE_URL=postgresql+psycopg://linesense_app:dev-app-only@db:5432/linesense
LS_MIGRATION_DATABASE_URL=postgresql+psycopg://linesense_owner:dev-owner-only@db:5432/linesense
LS_APP_DB_ROLE=linesense_app

LS_SESSION_SECRET=dev-session-secret-change-me-0123456789abcdef
LS_SERVICE_TOKEN=dev-service-token-change-me-0123456789

LS_PUBLIC_ORIGIN=https://localhost
LS_API_INTERNAL_URL=http://api:8000
# Only the private-network CIDR that the `web` (Caddy) container sits on may
# set X-Forwarded-* headers (see services/backend/docker-entrypoint.sh and
# infra/proxy/Caddyfile). Must match docker-compose.yml's networks.internal
# subnet.
LS_FORWARDED_ALLOW_IPS=172.28.0.0/24

# Keycloak (service `keycloak`, `dev` profile only). The client secret must
# equal the `linesense-web` client's secret in
# infra/identity/keycloak/linesense-realm.json.
LS_OIDC_ISSUER=https://idp.localhost/realms/linesense
LS_OIDC_CLIENT_ID=linesense-web
LS_OIDC_CLIENT_SECRET=dev-oidc-client-secret
LS_OIDC_REDIRECT_URI=https://localhost/auth/callback

# fixture is a deterministic test double, never a live model, and is
# forbidden when LS_ENVIRONMENT=production (see Settings' production
# validator). Set to anthropic and provide LS_ANTHROPIC_API_KEY for a real
# deployment.
LS_LLM_PROVIDER=fixture
LS_ANTHROPIC_API_KEY=
LS_ANTHROPIC_MODEL=claude-opus-5

LS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LS_EMBEDDER=fastembed

# Container-local paths (mounted volumes; see docker-compose.yml).
LS_DOCUMENT_STORAGE_DIR=/data/documents
LS_WORKER_ALIVE_DIR=/tmp/linesense

# ---------------------------------------------------------------------------
# Keycloak (service `keycloak`, `dev` profile) admin bootstrap.
# ---------------------------------------------------------------------------
LS_KEYCLOAK_ADMIN_USER=admin
LS_KEYCLOAK_ADMIN_PASSWORD=dev-keycloak-admin-only
